# Host-local deployment control file. Install as /etc/boresakshi/deploy.env (0600).
# It contains paths/controls, not application secrets themselves.
SERVER_ENV_FILE=/etc/boresakshi/production.server.env
ML_ENV_FILE=/etc/boresakshi/production.ml.env
RESTIC_ENV_FILE=/etc/boresakshi/restic.env
MODEL_ARTIFACT_DIR=/var/lib/boresakshi/model-artifacts
MONITORING_TOKEN_FILE=/etc/boresakshi/monitoring_token
ALERTMANAGER_CONFIG_FILE=/etc/boresakshi/alertmanager.yml
DEPLOY_BASE_URL=https://CHANGE_ME_PUBLIC_HOST
IMAGE_PREFIX=ghcr.io/suriyaprakash-25/boresakshi
RIG_MEDIA_VOLUME=boresakshi_rig_media
BACKUP_VOLUME=boresakshi_backups
OBSERVABILITY_ENABLED=YES
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
RESTIC_IMAGE=restic/restic:0.19.1
# RELEASE_VERSION is supplied by CI for deploys. Set it to the current image SHA
# for manual backup/restore drills that need an API image.
RELEASE_VERSION=CHANGE_ME_CURRENT_RELEASE_SHA
