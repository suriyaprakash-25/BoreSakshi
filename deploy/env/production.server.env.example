NODE_ENV=production
DEPLOYMENT_ENV=production
PORT=4000

# Managed/private MongoDB. Do not use localhost in production.
MONGODB_URI=CHANGE_ME_MANAGED_MONGODB_URI
MONGODB_DB=BoreSakshi

# Public HTTPS web origin. TLS terminates at your load balancer/reverse proxy.
FRONTEND_URL=https://boresakshi.example.org
ALLOWED_ORIGINS=https://boresakshi.example.org
TRUST_PROXY=1

# Generate distinct random values. Never commit populated production env files.
JWT_SECRET=CHANGE_ME_RANDOM_48_PLUS_CHARACTERS
RIG_EVIDENCE_SECRET=CHANGE_ME_DIFFERENT_RANDOM_48_PLUS_CHARACTERS
MONITORING_TOKEN=CHANGE_ME_RANDOM_32_PLUS_CHARACTERS
BACKUP_ENCRYPTION_KEY_BASE64=CHANGE_ME_32_RANDOM_BYTES_BASE64

SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=30
SIGNIN_FAILURE_LIMIT=5
PASSWORD_RESET_LIMIT=5
PREDICT_RATE_LIMIT=60
ADMIN_RATE_LIMIT=180

REQUIRE_ML_READY=YES
LOG_FORMAT=json
GRACEFUL_SHUTDOWN_MS=15000

# Compose overrides these to durable mounted paths and records the durability gate.
RIG_MEDIA_DIR=/var/lib/boresakshi/rig-media
BACKUP_DIR=/var/lib/boresakshi/backups
RIG_MEDIA_DURABLE=YES
OFFSITE_BACKUP_CONFIGURED=YES
RIG_MEDIA_UPLOAD_LIMIT=50mb
RIG_EVIDENCE_UNBOUND_MAX_AGE_HOURS=24

ML_SERVICE_URL=http://ml:8000
ML_SERVICE_TIMEOUT_MS=2500
ML_SERVICE_RETRIES=1
ML_CIRCUIT_FAILURE_THRESHOLD=3
ML_CIRCUIT_COOLDOWN_MS=30000
INGESTION_MAX_BYTES=5mb
