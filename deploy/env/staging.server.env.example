NODE_ENV=production
DEPLOYMENT_ENV=staging
PORT=4000
MONGODB_URI=mongodb://mongo:27017/
MONGODB_DB=BoreSakshiStaging
FRONTEND_URL=http://localhost:8080
TRUST_PROXY=1
ALLOW_INSECURE_LOCAL_ORIGIN=YES
JWT_SECRET=CHANGE_ME_STAGING_RANDOM_48_PLUS_CHARACTERS
RIG_EVIDENCE_SECRET=CHANGE_ME_STAGING_DIFFERENT_RANDOM_48_PLUS_CHARACTERS
MONITORING_TOKEN=CHANGE_ME_STAGING_RANDOM_32_PLUS_CHARACTERS
BACKUP_ENCRYPTION_KEY_BASE64=CHANGE_ME_STAGING_32_RANDOM_BYTES_BASE64
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12
REQUIRE_ML_READY=YES
LOG_FORMAT=json
GRACEFUL_SHUTDOWN_MS=15000
RIG_MEDIA_DIR=/var/lib/boresakshi/rig-media
BACKUP_DIR=/var/lib/boresakshi/backups
RIG_MEDIA_DURABLE=YES
OFFSITE_BACKUP_CONFIGURED=YES
RIG_MEDIA_UPLOAD_LIMIT=50mb
RIG_EVIDENCE_UNBOUND_MAX_AGE_HOURS=24
ML_SERVICE_URL=http://ml:8000
ML_SERVICE_TIMEOUT_MS=2500
ML_SERVICE_RETRIES=1
ML_CIRCUIT_FAILURE_THRESHOLD=3
ML_CIRCUIT_COOLDOWN_MS=30000
