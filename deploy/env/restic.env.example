# restic 0.19.1 off-site repository configuration.
# Copy outside Git and populate with your managed object-storage/SFTP repository.
# Examples:
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/boresakshi-production-backups
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
RESTIC_REPOSITORY=CHANGE_ME_OFFSITE_REPOSITORY
RESTIC_PASSWORD=CHANGE_ME_LONG_RANDOM_RESTIC_PASSWORD
