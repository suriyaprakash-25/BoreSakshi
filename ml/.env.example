# BoreSakshi Python ML service
# Generated model/evaluation/deployment artifacts remain outside Git.

# Phase 10 preferred runtime path: checksummed ACTIVE deployment pointer written
# by `python continuous.py activate ...`. When set, this pointer resolves the exact
# reviewed Phase 4 run, Phase 5 evaluation and live feature manifest.
BORESAKSHI_DEPLOYMENT_MANIFEST=

# Legacy/manual artifact-path mode remains supported when no deployment pointer is
# configured. These must reference one reviewed production artifact chain.
BORESAKSHI_PHASE4_RUN_DIR=artifacts/phase4-real-v1
BORESAKSHI_PHASE5_EVALUATION_DIR=evaluations/phase5-real-v1
BORESAKSHI_FEATURE_MANIFEST=../docs/your-feature-manifest.json

# GLOBAL SERVING KILL SWITCH. Phase 10 deployment pointers do not bypass this.
# Leave unset/NO until the reviewed production-serving gate is approved.
BORESAKSHI_PHASE6_APPROVED=NO

# Coverage policy. Below the minimum, /ml/predict returns 422 and Node serves an
# explicitly labelled heuristic fallback. Between minimum and warning threshold,
# ML is returned with a visible coverage warning.
BORESAKSHI_MIN_FEATURE_COVERAGE_PCT=60
BORESAKSHI_WARN_FEATURE_COVERAGE_PCT=80

LOG_LEVEL=INFO
