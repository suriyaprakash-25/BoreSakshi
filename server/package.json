{
  "name": "boresakshi-server",
  "version": "1.0.0",
  "description": "BoreSakshi backend — borewell logging, review-gated ML prediction and accountability ledger",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test",
    "test:all": "node --test --test-concurrency=1",
    "test:phase2": "node --test test/ingestion.test.js",
    "test:phase2:contract": "node --test test/phase2-contract.test.js",
    "test:phase3": "node --test test/geospatial.test.js test/featurePipeline.test.js",
    "test:phase6": "node --test test/mlClient.test.js test/predictPhase6.test.js",
    "test:phase7": "node --test test/mlClient.test.js test/predictPhase6.test.js test/predictionContract.test.js",
    "test:phase8": "node --test test/phase8.test.js test/phase8-compat.test.js test/phase8-time.test.js",
    "test:phase9": "node --test test/phase9.test.js test/phase9-hardening.test.js",
    "test:phase11": "node --test test/phase11.test.js",
    "test:phase15": "node --test test/phase15.test.js",
    "test:phase17": "node --test --test-concurrency=1",
    "test:phase17:e2e": "node --test --test-concurrency=1 test/phase17-e2e.test.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "backup:create": "node scripts/backup.js",
    "backup:verify": "node scripts/verify-backup.js",
    "backup:restore": "node scripts/restore-backup.js",
    "rig:evidence:cleanup": "node scripts/cleanup-rig-evidence.js",
    "dataset:validate": "node scripts/validate-dataset.js",
    "features:build": "node scripts/build-feature-dataset.js",
    "migrate:phase2": "node migrations/phase2-v1.js",
    "migrate:phase2:apply": "node migrations/phase2-v1.js --apply",
    "migrate:phase2:rollback": "node migrations/phase2-v1.js --rollback"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.8.0",
    "morgan": "^1.12.1",
    "nanoid": "^5.0.7",
    "zod": "^4.4.3"
  }
}
