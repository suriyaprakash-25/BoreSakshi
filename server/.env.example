# BoreSakshi backend — environment template.
# Copy this file to `.env` in the same folder and fill in real values.
#   cp .env.example .env   (or copy it in your editor)
# The .env file is gitignored and must never be committed.

# --- MongoDB ---------------------------------------------------------------
# Local dev:
MONGODB_URI=mongodb://localhost:27017/
# Free MongoDB Atlas cluster instead (recommended for deployment):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=BoreSakshi

# --- API -------------------------------------------------------------------
PORT=4000

# --- Auth ------------------------------------------------------------------
# Generate a long random secret (keep it private):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# How long a signed-in session lasts (e.g. 7d, 24h, 30m):
JWT_EXPIRES_IN=7d

# --- Phase 2 ingestion -----------------------------------------------------
# Maximum text/csv upload size accepted by the admin ingestion endpoint.
INGESTION_MAX_BYTES=5mb
# WRITE GATE: leave unset normally. Set to exactly YES only after the documented
# Phase 2 migration/reconciliation/privacy/contract-test review is approved.
# PHASE2_MIGRATION_APPROVED=YES

# --- Phase 6 ML service ----------------------------------------------------
# Node -> Python inference service. If unavailable, BoreSakshi returns an
# explicitly-labelled deterministic heuristic fallback; it never calls it ML.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=2500
ML_SERVICE_RETRIES=1
ML_CIRCUIT_FAILURE_THRESHOLD=3
ML_CIRCUIT_COOLDOWN_MS=30000

# --- Phase 8 rig evidence --------------------------------------------------
# Raw rig evidence is written beneath this directory. Phase 18 deployment must
# mount this path on durable/private storage; do not use an ephemeral filesystem
# for production evidence retention.
RIG_MEDIA_DIR=./rig-media
# Route-level parser limit. Per-file MIME limits are stricter in rigEvidence.js
# (10 MB photos / 50 MB videos).
RIG_MEDIA_UPLOAD_LIMIT=50mb
# Unsubmitted uploads older than this are removed by `npm run rig:evidence:cleanup`.
RIG_EVIDENCE_UNBOUND_MAX_AGE_HOURS=24
# Optional separate HMAC secret for 24-hour unbound-upload tokens. If omitted,
# JWT_SECRET is used. Production should set a distinct long random value.
RIG_EVIDENCE_SECRET=replace-with-a-different-long-random-secret

# --- Deployment only -------------------------------------------------------
# When hosted behind a reverse proxy (Render/Railway), set to 1 so client IPs
# (used by rate limiting) are read from X-Forwarded-For. Leave unset locally.
# TRUST_PROXY=1
# Set NODE_ENV=production on your host — this makes JWT_SECRET mandatory.
# NODE_ENV=production
