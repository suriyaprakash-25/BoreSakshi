# BoreSakshi backend — development/environment template.
# Copy to `.env`; never commit real secrets. For production use deploy/env/production.server.env.example.

# --- MongoDB ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=BoreSakshi

# --- API / browser origin --------------------------------------------------
PORT=4000
FRONTEND_URL=http://localhost:5173
# Optional extra origins for same-origin write validation. Production should use HTTPS.
# ALLOWED_ORIGINS=https://admin.example.org
# Behind a trusted reverse proxy, set this to the exact hop count (commonly 1).
# TRUST_PROXY=1

# --- Auth / sessions -------------------------------------------------------
# Generate distinct long random secrets:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
RIG_EVIDENCE_SECRET=replace-with-a-different-at-least-32-character-secret
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12
# Only for short migration windows. Production should leave disabled.
# ALLOW_LEGACY_JWT=YES

# --- Production security --------------------------------------------------
# Required in NODE_ENV=production for /api/internal/metrics.
MONITORING_TOKEN=replace-with-at-least-24-random-characters
# Only enable for trusted non-browser machine clients when they cannot send Origin.
# Prefer Authorization: Bearer ... instead.
# ALLOW_ORIGINLESS_WRITE=YES
# For local-only production simulations; never use for a public deployment.
# ALLOW_INSECURE_LOCAL_ORIGIN=YES

# Rate limits (per process).
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=30
SIGNIN_FAILURE_LIMIT=5
PASSWORD_RESET_LIMIT=5
PREDICT_RATE_LIMIT=60
ADMIN_RATE_LIMIT=180

# --- Health / monitoring ---------------------------------------------------
# Production Phase 18 requires YES so a deployment cannot become ready with ML down.
REQUIRE_ML_READY=NO

# --- Encrypted backup / recovery ------------------------------------------
# Exactly 32 random bytes encoded as base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY_BASE64=
BACKUP_DIR=./backups
# Restore always dry-runs unless --apply + this exact gate are both supplied.
# BORESAKSHI_RESTORE_APPROVED=YES
# MONGODB_RESTORE_DB=BoreSakshi_restore_test
# ALLOW_IN_PLACE_RESTORE=YES  # strongly discouraged

# --- Phase 2 ingestion -----------------------------------------------------
INGESTION_MAX_BYTES=5mb
# PHASE2_MIGRATION_APPROVED=YES

# --- Phase 6 ML service ----------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=2500
ML_SERVICE_RETRIES=1
ML_CIRCUIT_FAILURE_THRESHOLD=3
ML_CIRCUIT_COOLDOWN_MS=30000

# --- Phase 8 rig evidence --------------------------------------------------
RIG_MEDIA_DIR=./rig-media
RIG_MEDIA_UPLOAD_LIMIT=50mb
RIG_EVIDENCE_UNBOUND_MAX_AGE_HOURS=24

# --- Phase 18 deployment gates --------------------------------------------
DEPLOYMENT_ENV=development
RELEASE_VERSION=development
GRACEFUL_SHUTDOWN_MS=15000
# In a real production environment these become YES only after the controls are installed/tested.
RIG_MEDIA_DURABLE=NO
OFFSITE_BACKUP_CONFIGURED=NO
CENTRAL_LOGGING_CONFIGURED=NO
ALERT_DELIVERY_CONFIGURED=NO
# Production startup also requires absolute RIG_MEDIA_DIR/BACKUP_DIR paths,
# managed/non-local MongoDB, real non-placeholder secrets, and healthy approved ML.
# NODE_ENV=production
