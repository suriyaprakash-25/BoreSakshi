# BoreSakshi backend — environment template.
# Copy this file to `.env` in the same folder and fill in real values.
#   cp .env.example .env   (or copy it in your editor)
# The .env file is gitignored and must never be committed.

# --- MongoDB ---------------------------------------------------------------
# Local dev:
MONGODB_URI=mongodb://localhost:27017/
# Free MongoDB Atlas cluster instead (recommended for deployment):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=BoreSakshi

# --- API -------------------------------------------------------------------
PORT=4000

# --- Auth ------------------------------------------------------------------
# Generate a long random secret (keep it private):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# How long a signed-in session lasts (e.g. 7d, 24h, 30m):
JWT_EXPIRES_IN=7d

# --- Deployment only -------------------------------------------------------
# When hosted behind a reverse proxy (Render/Railway), set to 1 so client IPs
# (used by rate limiting) are read from X-Forwarded-For. Leave unset locally.
# TRUST_PROXY=1
# Set NODE_ENV=production on your host — this makes JWT_SECRET mandatory.
# NODE_ENV=production
# Exact browser origin allowed to use credentialed cookies (no trailing slash).
# FRONTEND_URL=https://app.example.com
# Cookie policy: strict is safest when frontend and API share a site. For
# different sites, use none (requires HTTPS) and keep CSRF protection enabled.
# COOKIE_SAME_SITE=strict
